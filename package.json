{
  "name": "tradingview-backtest-extension",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/content/index.ts --bundle --format=iife --target=chrome120 --outfile=dist/content.js && esbuild src/tradingview/page-bridge.ts --bundle --format=iife --target=chrome120 --outfile=dist/page-bridge.js",
    "watch": "esbuild src/content/index.ts --bundle --format=iife --target=chrome120 --outfile=dist/content.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
